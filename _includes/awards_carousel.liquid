{% comment %}
  Single award carousel: each slide shows ONE orientation only.
  Landscape slides: 2 certificates per slide (last slide may have 1, centered).
  Portrait slides: 3 certificates per slide (last slide may have 1, centered).
  Data: _data/awards_carousel.yml
{% endcomment %}

{% assign landscape_items = site.data.awards_carousel.landscape %}
{% assign portrait_items = site.data.awards_carousel.portrait %}
{% assign l_per = 2 %}
{% assign p_per = 3 %}
{% assign L = landscape_items.size %}
{% assign P = portrait_items.size %}
{% assign l_rem = L | modulo: l_per %}
{% assign p_rem = P | modulo: p_per %}
{% assign l_slides = L | minus: l_rem | divided_by: l_per %}
{% if l_rem > 0 %}
  {% assign l_slides = l_slides | plus: 1 %}
{% endif %}
{% assign p_slides = P | minus: p_rem | divided_by: p_per %}
{% if p_rem > 0 %}
  {% assign p_slides = p_slides | plus: 1 %}
{% endif %}
{% assign total_slides = l_slides | plus: p_slides %}

<section class="awards-carousels mt-4">
  {% if total_slides > 0 %}
    <div
      id="awardsCarousel"
      class="carousel slide awards-carousel"
      data-ride="carousel"
      data-interval="4500"
      data-pause="hover"
    >
      {% if total_slides > 1 %}
        <ol class="carousel-indicators">
          {% for i in (1..total_slides) %}
            <li
              data-target="#awardsCarousel"
              data-slide-to="{{ forloop.index0 }}"
              {% if forloop.first %}
                class="active"
              {% endif %}
            ></li>
          {% endfor %}
        </ol>
      {% endif %}

      <div class="carousel-inner">
        {% comment %} Landscape slides {% endcomment %}
        {% for i in (1..l_slides) %}
          {% assign slide_idx = forloop.index0 %}
          {% assign l_start = slide_idx | times: l_per %}
          {% assign remaining = L | minus: l_start %}
          {% assign slide_count = remaining %}
          {% if slide_count > l_per %}
            {% assign slide_count = l_per %}
          {% endif %}
          <div
            class="carousel-item awards-carousel__slide--landscape{% if slide_idx == 0 %} active{% endif %}{% if slide_count == 1 %} awards-carousel__slide--single{% endif %}"
          >
            <div class="awards-carousel__row awards-carousel__row--landscape">
              {% for offset in (0..1) %}
                {% assign l_idx = l_start | plus: offset %}
                {% if l_idx < L %}
                  {% assign item = landscape_items[l_idx] %}
                  <figure class="awards-carousel__figure mb-0">
                    <img
                      src="{{ item.path | relative_url }}"
                      alt="{{ item.caption }}"
                      class="img-fluid rounded z-depth-1 awards-carousel__img awards-carousel__img--landscape"
                      {% if slide_idx == 0 %}
                        loading="eager"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                    <figcaption class="caption awards-carousel__caption">{{ item.caption }}</figcaption>
                  </figure>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        {% comment %} Portrait slides {% endcomment %}
        {% for i in (1..p_slides) %}
          {% assign slide_idx = l_slides | plus: forloop.index0 %}
          {% assign p_start = forloop.index0 | times: p_per %}
          {% assign remaining = P | minus: p_start %}
          {% assign slide_count = remaining %}
          {% if slide_count > p_per %}
            {% assign slide_count = p_per %}
          {% endif %}
          <div
            class="carousel-item awards-carousel__slide--portrait{% if l_slides == 0 and forloop.first %} active{% endif %}{% if slide_count == 1 %} awards-carousel__slide--single{% endif %}"
          >
            <div class="awards-carousel__row awards-carousel__row--portrait">
              {% for offset in (0..2) %}
                {% assign p_idx = p_start | plus: offset %}
                {% if p_idx < P %}
                  {% assign item = portrait_items[p_idx] %}
                  <figure class="awards-carousel__figure mb-0">
                    <img
                      src="{{ item.path | relative_url }}"
                      alt="{{ item.caption }}"
                      class="img-fluid rounded z-depth-1 awards-carousel__img awards-carousel__img--portrait"
                      {% if slide_idx == 0 and p_idx == 0 %}
                        loading="eager"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                    <figcaption class="caption awards-carousel__caption">{{ item.caption }}</figcaption>
                  </figure>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if total_slides > 1 %}
        <a class="carousel-control-prev" href="#awardsCarousel" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#awardsCarousel" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
</section>
